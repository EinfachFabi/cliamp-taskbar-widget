    "Flat",
    "Rock",
    "Pop",
    "Jazz",
    "Classical",
    "Bass Boost",
    "Treble Boost",
    "Electronic",
    "Vocal",
    "Acoustic",
    "Late Night",
    "Hip-Hop",
    "R&B",
    "Loudness",
    "Custom",
]

DEFAULT_PROVIDERS = [
    {"key": "cliamp", "name": "cliamp Radio", "category": "radio", "icon": "radio", "description": "Curated synth, lofi, EDM & NCS streams"},
    {"key": "radio", "name": "Internet Radio", "category": "radio", "icon": "network-wireless", "description": "Global online radio stations"},
    {"key": "podcast", "name": "Podcasts", "category": "radio", "icon": "podcast", "description": "Podcast feeds & episodes"},
    {"key": "local", "name": "Local Playlists", "category": "local", "icon": "folder-music", "description": "Saved local TOML playlists"},
    {"key": "spotify", "name": "Spotify", "category": "cloud", "icon": "media-optical-audio", "description": "Spotify Connect / Librespot"},
