#!/usr/bin/env python3
"""
cliamp-kde-ctl — Controller & IPC Bridge for the cliamp KDE Plasma Taskbar Integration.
Provides fast JSON state snapshots, persistent volume & mute state,
daemon lifecycle management, terminal launching, and full playback/EQ control.
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional

