    {"key": "soundcloud", "name": "SoundCloud", "category": "cloud", "icon": "cloud", "description": "SoundCloud tracks & sets"},
    {"key": "bandcamp", "name": "Bandcamp", "category": "cloud", "icon": "album", "description": "Bandcamp collection & streams"},
